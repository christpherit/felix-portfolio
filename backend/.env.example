# System Environment Ports
PORT=5000
NODE_ENV=development

# MongoDB Connection URI (Atlas or Local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/felix-portfolio

# JWT Signature Token
JWT_SECRET=super_secret_auth_token_phrase

# Cloudinary Integration API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer Outgoing Notification Channels
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_email_app_password
NOTIFICATION_EMAIL=christopher.felix@example.com

# Default Seed Settings
ADMIN_PASSWORD=adminpassword
